{
  "name": "@relayerjs/nestjs-common",
  "version": "0.1.0",
  "description": "Shared NestJS utilities for Relayer — services, hooks, DI, and query primitives",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awHamer/relayer",
    "directory": "packages/nestjs-common"
  },
  "keywords": [
    "nestjs",
    "drizzle",
    "orm",
    "relayer",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@relayerjs/core": "workspace:~",
    "@relayerjs/drizzle": "workspace:~",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7.0.0",
    "class-validator": ">=0.13.0",
    "class-transformer": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "class-validator": {
      "optional": true
    },
    "class-transformer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@relayerjs/drizzle": "workspace:*",
    "@types/node": "^25.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
