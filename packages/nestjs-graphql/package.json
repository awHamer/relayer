{
  "name": "@relayerjs/nestjs-graphql",
  "version": "0.0.0",
  "description": "NestJS GraphQL integration for Relayer - code-first GraphQL CRUD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awHamer/relayer",
    "directory": "packages/nestjs-graphql"
  },
  "keywords": [
    "nestjs",
    "graphql",
    "drizzle",
    "orm",
    "relayer",
    "typescript",
    "code-first"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nestjs/apollo": ">=12.0.0",
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@nestjs/graphql": ">=12.0.0",
    "@relayerjs/core": "workspace:~",
    "@relayerjs/drizzle": "workspace:~",
    "@relayerjs/nestjs-common": "workspace:~",
    "graphql": ">=16.6.0",
    "graphql-scalars": ">=1.22.0",
    "reflect-metadata": ">=0.1.13",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@nestjs/apollo": "^13.0.4",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/graphql": "^13.0.4",
    "@relayerjs/core": "workspace:*",
    "@relayerjs/drizzle": "workspace:*",
    "@relayerjs/nestjs-common": "workspace:*",
    "@types/node": "^25.5.0",
    "vitest": "^3.2.4",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.24.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
